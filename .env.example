# Copy to .env and adjust for your deployment.

# --- Backend ---
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://hrcrm:hrcrm@localhost:5432/hrcrm?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Generate a strong secret in production, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-insecure-change-me
JWT_TTL=24h
CORS_ORIGIN=http://localhost:3000
SOFFICE_BIN=soffice
TEMPLATES_DIR=templates
BCRYPT_COST=12
MIGRATE_ON_BOOT=true

# --- Frontend ---
# Baked into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
